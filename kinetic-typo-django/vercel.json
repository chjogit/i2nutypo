{
  "builds": [
    { "src": "config/wsgi.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "X-Content-Type-Options": "nosniff"
      },
      "dest": "/static/$1"
    },
    { "src": "/(.*)", "dest": "config/wsgi.py" }
  ]
}
